<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="form-root" spacing="8"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.perpustakaan.controller.BookFormController">
    <padding>
        <Insets top="14" right="18" bottom="12" left="18"/>
    </padding>
    <Label fx:id="formTitle" text="Tambah Buku" styleClass="form-title"/>
    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>

    <TabPane fx:id="formTabs" styleClass="form-tabs" tabClosingPolicy="UNAVAILABLE"
             prefHeight="475" VBox.vgrow="ALWAYS">
        <Tab text="Informasi Buku">
            <GridPane hgap="12" vgap="8">
                <padding>
                    <Insets top="14" right="10" bottom="10" left="4"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                </columnConstraints>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                    <Label text="Judul buku" styleClass="field-label"/>
                    <TextField fx:id="judulField" styleClass="text-field" promptText="Judul lengkap buku"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Tahun terbit" styleClass="field-label"/>
                    <TextField fx:id="tahunField" styleClass="text-field" promptText="Contoh: 2024"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Jumlah halaman" styleClass="field-label"/>
                    <TextField fx:id="halamanField" styleClass="text-field" promptText="Kosongkan agar mengikuti PDF"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="ISBN" styleClass="field-label"/>
                    <TextField fx:id="isbnField" styleClass="text-field" promptText="ISBN (opsional)"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Penerbit" styleClass="field-label"/>
                    <TextField fx:id="penerbitField" styleClass="text-field" promptText="Nama penerbit (opsional)"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3">
                    <Label text="Kategori" styleClass="field-label"/>
                    <ComboBox fx:id="kategoriCombo" styleClass="combo-box" maxWidth="Infinity"
                              promptText="Pilih kategori"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <Label text="Format" styleClass="field-label"/>
                    <ComboBox fx:id="formatCombo" styleClass="combo-box" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                    <Label text="Sinopsis" styleClass="field-label"/>
                    <TextArea fx:id="sinopsisArea" styleClass="text-area" prefRowCount="4" maxHeight="100"
                              wrapText="true" promptText="Ringkasan isi buku (opsional, maksimal 2000 karakter)"/>
                </VBox>
            </GridPane>
        </Tab>

        <Tab text="Penulis">
            <VBox spacing="8">
                <padding>
                    <Insets top="12" right="10" bottom="10" left="4"/>
                </padding>
                <Label text="Pilih minimal satu penulis. Gunakan pencarian bila daftar cukup panjang."
                       styleClass="form-subtitle" wrapText="true"/>
                <VBox fx:id="authorPickerBox" VBox.vgrow="ALWAYS"/>
            </VBox>
        </Tab>

        <Tab text="Berkas">
            <VBox spacing="12">
                <padding>
                    <Insets top="14" right="10" bottom="10" left="4"/>
                </padding>
                <HBox spacing="16" alignment="TOP_LEFT">
                    <StackPane fx:id="coverPreview" styleClass="cover-preview"
                               minWidth="90" minHeight="120" prefWidth="90" prefHeight="120"
                               maxWidth="90" maxHeight="120"/>
                    <VBox spacing="7" HBox.hgrow="ALWAYS">
                        <Label text="Cover buku" styleClass="form-section-title"/>
                        <Label fx:id="coverPathLabel" text="Belum ada cover dipilih." styleClass="form-subtitle" wrapText="true"/>
                        <Button text="Pilih Cover JPG/PNG" styleClass="btn-secondary" onAction="#handleChooseCover"/>
                        <Label text="Opsional. Maksimal 5 MB." styleClass="hint-label"/>
                    </VBox>
                </HBox>

                <Region prefHeight="2"/>
                <VBox spacing="7">
                    <Label text="Berkas e-book" styleClass="form-section-title"/>
                    <Label fx:id="ebookPathLabel" text="Belum ada PDF dipilih." styleClass="form-subtitle" wrapText="true"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Pilih Berkas PDF" styleClass="btn-primary" onAction="#handleChooseEbook"/>
                        <Label fx:id="pageCountLabel" text="Pilih berkas PDF untuk melihat jumlah halaman."
                               styleClass="hint-label" wrapText="true"/>
                    </HBox>
                    <Label fx:id="existingFileHint" text="Buku baru wajib menggunakan berkas PDF."
                           styleClass="hint-label" wrapText="true"/>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
