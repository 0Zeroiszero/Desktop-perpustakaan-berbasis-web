<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page-root" spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.perpustakaan.controller.BooksController">
    <HBox styleClass="page-toolbar" alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="searchField" styleClass="text-field" promptText="Cari judul, ISBN, penulis..."
                   prefWidth="200"/>
        <ComboBox fx:id="categoryCombo" styleClass="combo-box" prefWidth="135"/>
        <ComboBox fx:id="formatCombo" styleClass="combo-box" prefWidth="130"/>
        <ComboBox fx:id="sortCombo" styleClass="combo-box" prefWidth="120"/>
        <Button fx:id="refreshButton" text="Muat ulang" styleClass="btn-ghost"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultLabel" text="0 buku ditemukan" styleClass="muted"/>
        <Button fx:id="addButton" text="Tambah Buku" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="table" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="coverColumn" text="Cover" prefWidth="64"/>
            <TableColumn fx:id="titleColumn" text="Judul" prefWidth="260"/>
            <TableColumn fx:id="authorColumn" text="Penulis" prefWidth="170"/>
            <TableColumn fx:id="categoryColumn" text="Kategori" prefWidth="120"/>
            <TableColumn fx:id="formatColumn" text="Format" prefWidth="80"/>
            <TableColumn fx:id="pagesColumn" text="Halaman" prefWidth="90"/>
            <TableColumn fx:id="actionsColumn" text="Aksi" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox fx:id="paginationBox" alignment="CENTER" spacing="8"/>
</VBox>
