<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page-root" spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.perpustakaan.controller.CategoriesController">
    <HBox styleClass="page-toolbar" alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="searchField" styleClass="text-field" promptText="Cari kategori..."
                   prefWidth="300"/>
        <Button fx:id="refreshButton" text="Muat ulang" styleClass="btn-ghost"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultLabel" text="0 kategori ditemukan" styleClass="muted"/>
        <Button fx:id="addButton" text="Tambah Kategori" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="table" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="namaColumn" text="Nama Kategori" prefWidth="220"/>
            <TableColumn fx:id="deskripsiColumn" text="Deskripsi" prefWidth="430"/>
            <TableColumn fx:id="jumlahColumn" text="Jumlah Buku" prefWidth="110"/>
            <TableColumn fx:id="actionsColumn" text="Aksi" prefWidth="90"/>
        </columns>
    </TableView>

    <HBox fx:id="paginationBox" alignment="CENTER" spacing="8"/>
</VBox>
