<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="shellRoot" styleClass="app-shell"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.perpustakaan.controller.MainShellController">
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="236" spacing="6">
            <padding>
                <Insets top="24" right="16" bottom="18" left="16"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="brand">
                <StackPane styleClass="brand-mark" minWidth="38" minHeight="38" prefWidth="38" prefHeight="38" maxWidth="38" maxHeight="38">
                    <Label text="P" styleClass="brand-letter"/>
                </StackPane>
                <VBox spacing="0">
                    <Label text="PustakaDigital" styleClass="brand-title"/>
                    <Label text="Perpustakaan digital" styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <Region prefHeight="18"/>
            <Label text="MENU UTAMA" styleClass="nav-section"/>

            <Button fx:id="dashboardButton" text="Dashboard" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#handleDashboard"/>
            <Button fx:id="catalogButton" text="Katalog Buku" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#handleCatalog"/>
            <Button fx:id="booksButton" text="Kelola Buku" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#handleBooks"/>
            <Button fx:id="categoriesButton" text="Kelola Kategori" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#handleCategories"/>
            <Button fx:id="authorsButton" text="Kelola Penulis" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#handleAuthors"/>
            <Button fx:id="usersButton" text="Kelola Pengguna" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#handleUsers"/>
            <Button fx:id="shelfButton" text="Rak Saya" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#handleShelf"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="sidebar-card" spacing="4">
                <Label text="Kebiasaan kecil" styleClass="sidebar-card-title"/>
                <Label text="Baca 10 halaman setiap hari untuk menjaga ritme membaca."
                       styleClass="sidebar-card-text" wrapText="true"/>
            </VBox>

            <Button fx:id="logoutButton" text="Keluar" styleClass="nav-item"
                    maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <top>
        <HBox fx:id="header" styleClass="header" alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>
            <VBox spacing="2">
                <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title"/>
                <Label fx:id="pageSubtitle" text="Ringkasan aktivitas perpustakaan."
                       styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="user-chip" alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="avatarLabel" text="AP" styleClass="avatar"/>
                <VBox spacing="0">
                    <Label fx:id="userNameLabel" text="Admin Pustaka" styleClass="user-name"/>
                    <Label fx:id="userRoleLabel" text="Admin" styleClass="user-role role-admin"/>
                </VBox>
            </HBox>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="centerStack" styleClass="page-content">
            <StackPane fx:id="contentPane" styleClass="content-pane"/>

            <StackPane fx:id="busyLayer" styleClass="busy-layer">
                <VBox alignment="CENTER" spacing="12" styleClass="busy-card">
                    <ProgressIndicator prefWidth="38" prefHeight="38"/>
                    <Label fx:id="busyLabel" text="Memuat..." styleClass="busy-label"/>
                </VBox>
            </StackPane>

            <VBox fx:id="toastBox" alignment="TOP_RIGHT" spacing="8"
                  styleClass="toast-layer" pickOnBounds="false"
                  StackPane.alignment="TOP_RIGHT"/>
        </StackPane>
    </center>
</BorderPane>
