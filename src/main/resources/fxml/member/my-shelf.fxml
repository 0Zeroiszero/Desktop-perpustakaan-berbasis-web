<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page-root" spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.perpustakaan.controller.MyShelfController">
    <HBox styleClass="page-toolbar" alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="searchField" styleClass="text-field" promptText="Cari di rak saya..."
                   prefWidth="280"/>
        <ComboBox fx:id="sortCombo" styleClass="combo-box" prefWidth="160"/>
        <Button fx:id="refreshButton" text="Muat ulang" styleClass="btn-ghost"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="resultLabel" text="0 buku di rak" styleClass="muted"/>
        <Button fx:id="browseButton" text="Jelajahi Katalog" styleClass="btn-primary"
                onAction="#handleBrowse"/>
    </HBox>

    <TableView fx:id="table" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleColumn" text="Buku" prefWidth="330"/>
            <TableColumn fx:id="categoryColumn" text="Kategori" prefWidth="120"/>
            <TableColumn fx:id="progressColumn" text="Progres" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
            <TableColumn fx:id="lastReadColumn" text="Terakhir" prefWidth="100"/>
            <TableColumn fx:id="actionsColumn" text="Aksi" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox fx:id="paginationBox" alignment="CENTER" spacing="8"/>
</VBox>
