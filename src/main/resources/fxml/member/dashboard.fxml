<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="dashboard-root" spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.perpustakaan.controller.MemberDashboardController">
    <HBox styleClass="welcome-banner" alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label fx:id="welcomeLabel" text="Selamat datang." styleClass="welcome-title"/>
            <Label fx:id="welcomeSubtitle" text="Temukan bacaan berikutnya dan lanjutkan progres Anda."
                   styleClass="welcome-subtitle"/>
        </VBox>
        <Button fx:id="browseButton" text="Jelajahi Katalog" styleClass="welcome-button"
                onAction="#handleBrowse"/>
    </HBox>

    <HBox fx:id="statsRow" styleClass="stats-row" spacing="12"/>

    <HBox fx:id="lastReadCard" styleClass="last-read-card" alignment="CENTER_LEFT" spacing="16">
        <StackPane fx:id="lastReadCover" styleClass="last-read-cover"
                   minWidth="70" minHeight="96" prefWidth="70" prefHeight="96"
                   maxWidth="70" maxHeight="96"/>
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="LANJUTKAN MEMBACA" styleClass="eyebrow"/>
            <Label fx:id="lastReadTitle" text="Belum ada bacaan terakhir" styleClass="last-read-title"
                   wrapText="true"/>
            <Label fx:id="lastReadAuthor" text="Tambahkan buku ke rak untuk mulai membaca."
                   styleClass="last-read-author" wrapText="true"/>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <ProgressBar fx:id="lastReadProgressBar" progress="0" prefWidth="260" maxWidth="360"/>
                <Label fx:id="lastReadProgressLabel" text="0%" styleClass="last-read-progress"/>
            </HBox>
        </VBox>
        <Button fx:id="continueButton" text="Lanjutkan" styleClass="btn-primary"
                onAction="#handleContinue"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="8">
        <VBox spacing="2">
            <Label text="Rekomendasi untuk Anda" styleClass="dashboard-section-title"/>
            <Label text="Buku terbaru dari koleksi perpustakaan" styleClass="dashboard-section-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="viewAllButton" text="Lihat semua" styleClass="btn-ghost" onAction="#handleViewAll"/>
    </HBox>

    <HBox fx:id="recommendationRow" spacing="12" VBox.vgrow="ALWAYS"/>
</VBox>
